LIFELINK_ENVIRONMENT=local
LIFELINK_DATABASE_URL=postgresql://lifelink:CHANGE_ME@127.0.0.1:5434/lifelink
LIFELINK_TEST_DATABASE_URL=postgresql://lifelink:CHANGE_ME@127.0.0.1:5434/lifelink_test

# Generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars; the placeholder is deliberately too short so the app refuses to start)
LIFELINK_JWT_SECRET=CHANGE_ME
# false only for plain-http local dev
LIFELINK_COOKIE_SECURE=false

# owner account for `manage.py migrate` (the app itself connects as the least-privilege role, ADR 014)
LIFELINK_MIGRATIONS_DATABASE_URL=postgresql://lifelink:CHANGE_ME@127.0.0.1:5434/lifelink
# password manage.py migrate sets on the lifelink_app role
LIFELINK_APP_DB_PASSWORD=CHANGE_ME
# optional: fixed password for `manage.py seed-demo` accounts (unset = random, written to demo-credentials.txt)
# LIFELINK_DEMO_PASSWORD=CHANGE_ME

# Copy to .env and replace every value:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
# at least 32 characters, or the API refuses to start
JWT_SECRET=CHANGE_ME
# optional host ports (defaults 5434 / 8000 / 3000)
# DB_PORT=5434
# API_PORT=8000
# WEB_PORT=3000
# optional uvicorn worker processes for the api container (default 4, see docs/adr/019-load-test.md)
# API_WORKERS=4
